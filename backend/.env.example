# ==========================================
# SahayakAI Backend Environment Variables Template
# ==========================================

# --- App Settings ---
PROJECT_NAME="SahayakAI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# --- CORS (Frontend Next.js connection) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & JWT Auth ---
SECRET_KEY=replace_with_your_own_secret_key_or_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
DATABASE_URL=sqlite:///./sahayak.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahayakai_db

# --- AI & LLM Service Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Vector Store & ML Models ---
VECTOR_STORE_PATH="./app/ml_artifacts/vector_store"
MODEL_ARTIFACTS_PATH="./app/ml_artifacts"
